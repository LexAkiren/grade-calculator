pipeline {
    agent any

    parameters {
        string(name: 'CI_BUILD_NUMBER', defaultValue: '', description: 'Build number from CI-Grade-Calculator/main')
        choice(name: 'ENVIRONMENT', choices: ['DEV', 'TEST', 'ACC', 'PROD'], description: 'Target environment')
    }

    stages {
        stage('Validate') {
            steps {
                script {
                    if (!(params.CI_BUILD_NUMBER ==~ /\d+/)) {
                        error('CI_BUILD_NUMBER must be a number')
                    }
                }
                echo "Selected CI build: ${params.CI_BUILD_NUMBER}"
                echo "Selected environment: ${params.ENVIRONMENT}"
            }
        }

        stage('Download Artifact') {
            steps {
                copyArtifacts(
                    projectName: 'CI-Grade-Calculator/main',
                    selector: specific(params.CI_BUILD_NUMBER),
                    filter: 'react-app-*.tar.gz'
                )
            }
        }

        stage('Prepare Files') {
            steps {
                sh '''
                    rm -rf deploy && mkdir deploy
                    tar -xzf react-app-${CI_BUILD_NUMBER}.tar.gz -C deploy
                    test -f deploy/Dockerfile
                    test -f deploy/dist/index.html
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    env.IMAGE = "grade-calculator-${params.ENVIRONMENT.toLowerCase()}:${params.CI_BUILD_NUMBER}"
                }
                sh 'docker build -t $IMAGE deploy'
            }
        }

        stage('Deploy to Docker') {
            steps {
                script {
                    def ports = [DEV: '8081', TEST: '8082', ACC: '8083', PROD: '8084']
                    env.PORT = ports[params.ENVIRONMENT]
                    env.CONTAINER = "grade-${params.ENVIRONMENT.toLowerCase()}"
                }
                sh '''
                    docker rm -f $CONTAINER || true
                    docker run -d --name $CONTAINER -p $PORT:80 $IMAGE
                '''
                echo "Deployed CI build ${params.CI_BUILD_NUMBER} to ${params.ENVIRONMENT}"
                echo "Open http://localhost:${env.PORT}"
            }
        }
    }
}
